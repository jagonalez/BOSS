#!/bin/sh
# The `boss` command: open a folder as a BOSS project.
#
# Installed as a symlink into a PATH directory, pointing back at this file
# inside BOSS.app. Resolving the symlink is what lets the shim find the app it
# belongs to, so an update that replaces the bundle needs no reinstall.
#
# The heavy lifting is Electron's: launching the app with --boss-open either
# starts it on that folder, or loses the single-instance lock and hands the
# folder to the instance already running. Both paths end in the same place.
set -eu

target="${1:-.}"
case "$target" in
  -h|--help|help)
    echo "usage: boss [folder]"
    echo
    echo "Opens a folder as a BOSS project, creating the project if the folder"
    echo "is not one yet. Defaults to the current directory. With BOSS already"
    echo "running, the folder opens in that window."
    exit 0
    ;;
  -*)
    echo "boss: unknown option '$target'" >&2
    echo "usage: boss [folder]" >&2
    exit 2
    ;;
esac

if [ ! -d "$target" ]; then
  echo "boss: '$target' is not a folder" >&2
  exit 1
fi

# Absolute, because the app is not started from this directory. `pwd -P`
# resolves symlinks the same way the main process canonicalizes a project path.
target=$(cd "$target" && pwd -P)

# .../BOSS.app/Contents/Resources/cli/boss -> .../BOSS.app
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case "$link" in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
resources=$(cd "$(dirname "$self")/.." && pwd -P)
app=$(cd "$resources/../.." && pwd -P)

case "$(uname -s)" in
  Darwin)
    # `open` rather than the binary directly: it hands the launch to macOS,
    # which brings an already-running BOSS to the front instead of leaving it
    # behind the terminal. --args are appended to the launch's argv.
    open -a "$app" --args --boss-open "$target"
    ;;
  *)
    # Linux: Contents/Resources/cli/boss has no bundle above it, so the
    # executable sits beside the resources directory instead.
    binary="$resources/../boss"
    [ -x "$binary" ] || binary="$app/boss"
    "$binary" --boss-open "$target" >/dev/null 2>&1 &
    ;;
esac
