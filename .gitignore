node_modules
out
playwright-report
test-results
dist
.DS_Store
*.log
resources/opencode/*
!resources/opencode/.gitkeep
resources/cua-driver/*
!resources/cua-driver/.gitkeep

# Never commit key material. A Tailscale TLS keypair reached the repo once.
*.key
*.pem
*.p12
*.crt
*.cer
*.mobileprovision

# Worktrees. .boss/ is also added to .git/info/exclude when worktrees are set
# to live in the project; this covers a clone that never enabled that, and
# .claude/ for the worktrees Claude Code makes with its own EnterWorktree.
.boss/
.claude/worktrees/

# Throwaway scripts for poking a running relay or checking a QR render, and
# PR text drafted in the tree rather than typed into GitHub.
qrcheck.mjs
qrdiff.mjs
PR_DESCRIPTION.md

# The Expo app's dependencies, not the app itself.
mobile/node_modules/
mobile/.expo/
