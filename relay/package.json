{
  "name": "boss-relay",
  "version": "0.1.0",
  "private": true,
  "description": "Stateless WebSocket relay that pairs a BOSS desktop with its phones",
  "type": "module",
  "main": "dist/relay/src/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/relay/src/server.js",
    "dev": "npm run build && node dist/relay/src/server.js",
    "// pretest": "The pairing test drives the real desktop RelayClient. That is app code and uses bundler-style imports Node's runner cannot resolve, so bundle it into dist/ first.",
    "pretest": "npx esbuild ../src/main/relay-client.ts --bundle --platform=node --format=esm --outfile=dist/test/relay-client.mjs --external:ws --external:electron",
    "test": "npm run build && node --experimental-strip-types --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.3"
  }
}
