{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    // One tree. The phone page is copied into src/shared by `npm run sync`
    // rather than imported from ../src/shared: spanning two roots made the
    // emitted layout depend on where the build ran, so the container produced
    // a different one from the local build and the deploy died on startup.
    "rootDir": "src",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    // Superseded by src/shared/identity.ts, which the desktop, the relay and
    // the phone all share. Two copies of verification logic is how the last
    // deploy broke; one copy is the point.
    "src/verify.ts"
  ]
}
