{
  "expo": {
    "name": "BOSS",
    "slug": "boss",
    "scheme": "boss",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d10",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.boss.app",
      "infoPlist": {
        "NSCameraUsageDescription": "BOSS uses the camera once, to scan the pairing code shown on your desktop.",
        "ITSAppUsesNonExemptEncryption": true
      }
    },
    "android": {
      "package": "dev.boss.app",
      "adaptiveIcon": {
        "backgroundColor": "#0b0d10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-camera",
      "expo-asset"
    ],
    "owner": "jeremygonzalez",
    "extra": {
      "eas": {
        "projectId": "176ef4f1-609e-4fac-a510-f9f2f092298c"
      }
    }
  }
}
