{
  "name": "ralf",
  "productName": "R.A.L.F.",
  "version": "0.1.0",
  "description": "Configurable multi-backend desktop workspace for coding agents",
  "main": "./out/main/index.js",
  "author": "jeremy",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "fetch:opencode": "node scripts/fetch-opencode.mjs",
    "fetch:cua-driver": "bash scripts/fetch-cua-driver.sh",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.11.1",
    "kokoro-js": "^1.2.1",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.8.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "dev.ralf.app",
    "productName": "R.A.L.F.",
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "icon": "resources/icons/512x512.png",
    "extraResources": [
      {
        "from": "resources/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/cua-driver",
        "to": "cua-driver",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sites-mcp",
        "to": "sites-mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
