{
  "name": "boss",
  "productName": "BOSS",
  "version": "0.1.1",
  "description": "Configurable multi-backend desktop workspace for coding agents",
  "main": "./out/main/index.js",
  "author": "jeremy",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "postinstall": "node scripts/fix-pty-permissions.mjs",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\"",
    "test:transcripts": "node --experimental-strip-types --test src/main/transcript-store.test.ts",
    "test:workspaces": "node --experimental-strip-types --test src/renderer/src/lib/workspaces.test.ts",
    "test:mobile": "node --experimental-strip-types --test src/main/mobile-page.test.ts",
    "test:events": "node --experimental-strip-types --test src/main/event-stream.test.ts src/main/backend/opencode-backend.test.ts",
    "test:policy": "node --experimental-strip-types --test src/shared/task-policy.test.ts",
    "test:version": "node --experimental-strip-types --test src/shared/version.test.ts",
    "test:projects": "node --experimental-strip-types --test src/main/project-identity.test.ts",
    "test:review": "node --experimental-strip-types --test src/main/review-manager.test.ts src/main/github-review-provider.test.ts src/renderer/src/lib/themes.test.ts",
    "test:claude": "node --experimental-strip-types --test src/main/backend/claude-backend.test.ts",
    "fetch:opencode": "node scripts/fetch-opencode.mjs",
    "fetch:cua-driver": "bash scripts/fetch-cua-driver.sh",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.8.1",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/ws": "^8.18.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "kokoro-js": "^1.2.1",
    "node-pty": "^1.1.0",
    "onnxruntime-node": "^1.27.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^42.8.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.1.0",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "dev.boss.app",
    "productName": "BOSS",
    "publish": {
      "provider": "github",
      "owner": "jagonalez",
      "repo": "BOSS"
    },
    "files": [
      "out/**/*",
      "resources/**/*"
    ],
    "icon": "resources/icons/512x512.png",
    "extraResources": [
      {
        "from": "resources/opencode",
        "to": "opencode",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/cua-driver",
        "to": "cua-driver",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sites-mcp",
        "to": "sites-mcp",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "icon": "resources/icons/icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "signIgnore": [
        "cua-driver/cua-driver",
        "cua-driver/cua-cursor-theme"
      ],
      "notarize": {
        "teamId": "78UU74XQFK"
      }
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
